{
  "priority": 5,
  "request": {
    "method": "POST",
    "urlPathPattern": "/risk-score/([0-9]+)"
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "status": "saved",
      "customer_id": "{{request.pathSegments.[2]}}",
      "timestamp": "{{now}}"
    },
    "transformers": ["response-template"]
  }
}
