{
  "suiteName": "lifecycle-suite",
  "schemaVersion": 1,
  "beforeAll": [
    {
      "hookType": "beforeAll",
      "actions": [
        {
          "actionType": "s3:putObject",
          "params": {
            "bucket": "config-bucket",
            "key": "setup.json",
            "content": "{}"
          }
        }
      ],
      "order": 0
    }
  ],
  "afterAll": [
    {
      "hookType": "afterAll",
