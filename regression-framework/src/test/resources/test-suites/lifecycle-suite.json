    }
  ],
  "cases": [
    {
      "caseName": "lifecycle-case",
      "steps": [
        {
          "stepName": "step1",
          "action": {
            "actionType": "s3:putObject",
            "params": {
              "bucket": "test-bucket",
              "key": "test-key",
              "content": "test content"
            }
          }
        }
      ]
    }
  ]
